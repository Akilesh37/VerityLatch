# VerityLatch Configuration
ENVIRONMENT=development
DEBUG=true

# Security
SECRET_KEY=change-this-in-production-to-a-secure-random-256-bit-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local SQLite default:
DATABASE_URL=sqlite:///./veritylatch.db
# PostgreSQL for Docker / Production:
# DATABASE_URL=postgresql://verityuser:veritypassword2026@localhost:5432/veritylatch

# OPA Policy Engine
OPA_URL=http://localhost:8181/v1/data/veritylatch/authz

# Optional Live LLM Providers (Mock provider is used by default)
LLM_PROVIDER=mock
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=mock-enterprise-v1

# Risk Engine Thresholds
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MEDIUM=60
RISK_THRESHOLD_HIGH=80

